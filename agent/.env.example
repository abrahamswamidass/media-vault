# Copy to .env and point the paths at your machine.
# Relative paths resolve from this file's folder (agent/), which is why the
# defaults reach up one level into the repo's sample tree.

# --- Sources ---------------------------------------------------------------- #
HOST_NAS_PATH=../sample/nas
HOST_TRASH_PATH=../sample/nas/_trash
HOST_AMAZON_STAGING=../sample/amazon_staging
HOST_ARCHIVES=../sample/archives

# --- NAS: direct SMB mode (alternative to the mount above) ------------------ #
# Docker Desktop on Windows can't reliably bind-mount a mapped network drive
# (Z:\ etc) — the container sees the mount but the share's contents don't come
# through. If HOST_NAS_PATH mounts empty, set NAS_MODE=smb instead: the agent
# then talks SMB2/3 directly over the network and HOST_NAS_PATH/HOST_TRASH_PATH
# above are ignored.
NAS_MODE=mount
NAS_HOST=
NAS_SHARE=
NAS_SMB_ROOT=
NAS_SMB_TRASH=
NAS_USER=
# Password goes in a FILE under secrets/, never directly in .env.
NAS_PASSWORD_FILE=

# --- Local state (catalog DB, action journal, blob cache) ------------------- #
HOST_CATALOG=../data/catalog

# --- Credentials ------------------------------------------------------------ #
HOST_SECRETS=../secrets

# --- Live switches ---------------------------------------------------------- #
# Both default to OFF. Nothing reaches a cloud API until you flip these,
# so a half-configured machine can't surprise you with a write or a bill.
DRIVE_LIVE=0
GCS_LIVE=0

# Set once the bucket exists. Give it a lifecycle rule deleting previews/
# after 1 day — that rule is the only thing stopping full-res fetches from
# accumulating.
GCS_BUCKET=

# --- Running the prebuilt image --------------------------------------------- #
# Leave unset to build locally. Set it to the image GitHub Actions publishes to
# pull instead of building (replace OWNER with your GitHub username, lowercase):
# MEDIAVAULT_IMAGE=ghcr.io/OWNER/media-vault/agent:latest
