rules_version = '2';

// Single-user gate: only the owner's Google account can read. Enforced here
// server-side — the client UI hiding the sign-in button is not what makes
// this private, this rule is. Writes are always denied: the agent writes via
// a service-account Admin client, which bypasses these rules entirely, so
// `intents/` staying web-writable would need its own rule when that lands.
service cloud.firestore {
  match /databases/{database}/documents {
    match /items/{itemId} {
      allow read: if request.auth != null
                  && request.auth.token.email == "winfredbe@gmail.com";
      allow write: if false;
    }
  }
}
