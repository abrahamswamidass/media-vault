rules_version = '2';

// Same allowlist gate as firestore.rules, for the bucket holding
// thumbnails. Deploy this against the "mymediavault" bucket specifically
// (see docs/setup.md's "Web viewer" section) — Firebase Storage rules are
// per-bucket, not shared automatically across additional buckets.
service firebase.storage {
  match /b/{bucket}/o {
    match /thumbs/{fileName} {
      allow read: if request.auth != null
                  && request.auth.token.email in ["winfredbe@gmail.com", "percial@gmail.com"];
      allow write: if false;
    }
    // Same allowlist, needed for the web module's "Full res" tab to resolve
    // a completed fetch_fullres intent's result blob (see
    // agent/actions/derive.py's FetchFullResAction and web/views/fullres.js).
    // Still self-cleaning: the bucket's lifecycle rule empties this prefix
    // after a day regardless of whether anyone ever read it.
    match /previews/{variant}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.token.email in ["winfredbe@gmail.com", "percial@gmail.com"];
      allow write: if false;
    }
    // Everything else (any future originals mirror) stays denied by default
    // — only thumbs/ and previews/ are ever meant to be browser-readable.
  }
}
